{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "composite": false,
    "incremental": false,
    "noEmit": true
  },
  "include": ["src/**/*.mjs", "tests/**/*.ts"]
}
